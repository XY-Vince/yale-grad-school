                <h2>In Memoriam</h2>
            </div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 px-4 lg:px-8 border-none">
            <div class="col-span-1 mb-2 lg:mb-0 lg:py-6">
                <h3></h3>
            </div>
            <div class="col-span-1 lg:col-span-2">
                                    <div class="bg-white relative pb-6 lg:py-6 border-t border-light-gray first:border-t-0">
                                                    <div></div>
