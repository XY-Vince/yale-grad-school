<li class="gallerybox" style="width: 144.66666666667px;" id="mwAyE"><div class="thumb" style="width: 142.66666666667px;" id="mwAyI"><span typeof="mw:File" id="mwAyM"><a href="https://en.wikipedia.org/wiki/File:2351614616_BPL_BoylstonSt.jpg" class="mw-file-description" title="Lower hall stacks, Kirby Building, Boylston St., 1858–1895" id="mwAyQ"><img resource="https://en.wikipedia.org/wiki/File:2351614616_BPL_BoylstonSt.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/24/2351614616_BPL_BoylstonSt.jpg/250px-2351614616_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/24/2351614616_BPL_BoylstonSt.jpg/500px-2351614616_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Lower hall stacks, Kirby Building, Boylston St., 1858–1895" data-file-width="654" data-file-height="643" data-file-type="bitmap" height="140" width="143" class="mw-file-element" id="mwAyU"/></a></span></div><div class="gallerytext" id="mwAyY">Lower hall stacks, Kirby Building, Boylston St., 1858–1895</div></li>
<li class="gallerybox" style="width: 132.66666666667px;" id="mwAyc"><div class="thumb" style="width: 130.66666666667px;" id="mwAyg"><span typeof="mw:File" id="mwAyk"><a href="https://en.wikipedia.org/wiki/File:2351614078_BPL_BoylstonSt.jpg" class="mw-file-description" title="Upper (Bates) hall, Kirby Building, Boylston St., 1858–1895" id="mwAyo"><img resource="https://en.wikipedia.org/wiki/File:2351614078_BPL_BoylstonSt.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/2351614078_BPL_BoylstonSt.jpg/250px-2351614078_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/2351614078_BPL_BoylstonSt.jpg/500px-2351614078_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Upper (Bates) hall, Kirby Building, Boylston St., 1858–1895" data-file-width="639" data-file-height="684" data-file-type="bitmap" height="140" width="131" class="mw-file-element" id="mwAys"/></a></span></div><div class="gallerytext" id="mwAyw">Upper (Bates) hall, Kirby Building, Boylston St., 1858–1895</div></li>
<li class="gallerybox" style="width: 176px;" id="mwAy0"><div class="thumb" style="width: 174px;" id="mwAy4"><span typeof="mw:File" id="mwAy8"><a href="https://en.wikipedia.org/wiki/File:2350784443_BPL_BoylstonSt.jpg" class="mw-file-description" title="Lower hall indicator, Kirby Building, Boylston St., 1858–1895" id="mwAzA"><img resource="https://en.wikipedia.org/wiki/File:2350784443_BPL_BoylstonSt.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/8/84/2350784443_BPL_BoylstonSt.jpg/330px-2350784443_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/8/84/2350784443_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" alt="Lower hall indicator, Kirby Building, Boylston St., 1858–1895" data-file-width="628" data-file-height="505" data-file-type="bitmap" height="140" width="174" class="mw-file-element" id="mwAzE"/></a></span></div><div class="gallerytext" id="mwAzI">Lower hall indicator, Kirby Building, Boylston St., 1858–1895</div></li>
<li class="gallerybox" style="width: 133.33333333333px;" id="mwAzM"><div class="thumb" style="width: 131.33333333333px;" id="mwAzQ"><span typeof="mw:File" id="mwAzU"><a href="https://en.wikipedia.org/wiki/File:2351613774_BPL_BoylstonSt.jpg" class="mw-file-description" title="Lower hall reading room, Kirby Building, Boylston St., 1858–1895" id="mwAzY"><img resource="https://en.wikipedia.org/wiki/File:2351613774_BPL_BoylstonSt.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/71/2351613774_BPL_BoylstonSt.jpg/250px-2351613774_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/71/2351613774_BPL_BoylstonSt.jpg/500px-2351613774_BPL_BoylstonSt.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Lower hall reading room, Kirby Building, Boylston St., 1858–1895" data-file-width="637" data-file-height="680" data-file-type="bitmap" height="140" width="132" class="mw-file-element" id="mwAzc"/></a></span></div><div class="gallerytext" id="mwAzg">Lower hall reading room, Kirby Building, Boylston St., 1858–1895</div></li>
