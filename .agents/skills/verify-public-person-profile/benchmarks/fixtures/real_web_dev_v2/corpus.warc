<span class="mw-empty-elt" about="#mwt4" typeof="mw:Transclusion" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox library\n","href":"./Template:Infobox_library"},"params":{"logo":{"wt":"BostonPublicLibrary SealoftheTrustees.svg"},"logo_alt":{"wt":"The Seal of the Trustees of the Boston Public Library, as designed by [[Augustus Saint-Gaudens]]"},"logo_class":{"wt":"skin-invert-image"},"logo_size":{"wt":"125px"},"image":{"wt":"Boston Public Library logo (2018).png &lt;!-- Kept to allow Motto in Caption field, no caption for logo images, or motto field available in template-->"},"image_class":{"wt":"skin-invert-image"},"image_size":{"wt":"200px"},"caption":{"wt":"&apos;&apos;&apos;Motto&apos;&apos;&apos;: &apos;&apos;Omnium Lux Civium&apos;&apos; &lt;small>([[Latin]])&lt;/small>&lt;br />\"The Light of All People\""},"country":{"wt":"US"},"type":{"wt":"Public"},"established":{"wt":"1848"},"city":{"wt":"[[Boston]]"},"state":{"wt":"Massachusetts"},"coordinates":{"wt":"{{coord|42|20|57.55|N|71|4|41.78|W|display=inline, title}}"},"public_transit":{"wt":"{{rint|Boston|green|icon}} [[Copley station|Copley]] {{access icon}}"},"num_branches":{"wt":"24"},"collection_size":{"wt":"24,079,520"},"annual_circulation":{"wt":"7.6 million (FY 2025)&lt;ref name=\"FY25FinancialStatement\">{{cite web|title=FY 25 Financial Statements|url=https://www.bpl.org/wp-content/uploads/sites/30/2026/01/Boston-Public-Library-FS-FY25.pdf|access-date=2026-03-02|website=bpl.org}}&lt;/ref>"},"pop_served":{"wt":"6,547,629 &lt;!--the library serves the entire state of Massachusetts | http://www.bpl.org/general/circulation/borrowers.htm-->"},"budget":{"wt":"$49.5 million (FY 2026)&lt;ref>{{cite web|title=City of Boston Operating Budget Fiscal Year 2026|url=https://www.boston.gov/sites/default/files/file/2025/11/Full%20Budget%20Document.pdf|access-date=2026-03-02|publisher=City of Boston|website=Boston.gov}}&lt;/ref>"},"director":{"wt":"David Leonard, President&lt;ref>{{cite web |url=http://www.bpl.org/general/management.htm |publisher=Bpl.org |title=BPL – Management Staff |access-date=2013-01-02 |archive-date=2017-06-18 |archive-url=https://web.archive.org/web/20170618053716/http://www.bpl.org/general/management.htm |url-status=dead }}&lt;/ref>&lt;br />Ray Liu, Chair of the Board&lt;ref>{{cite web |url=https://www.bpl.org/about-the-bpl/board-of-trustees/ |title=Board of Trustees |website=bpl.org |access-date=2026-03-02 }}&lt;/ref>"},"num_employees":{"wt":""},"affiliation":{"wt":"[[Boston Library Consortium]]"},"website":{"wt":"{{URL|https://www.bpl.org/|bpl.org}}"},"module":{"wt":""}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--resp